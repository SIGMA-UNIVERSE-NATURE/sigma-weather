# ================================================================
# 🌤️ HÀM LẤY DỮ LIỆU MƯA
# ================================================================
def get_rain_data(lat, lon):
    url = f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&hourly=precipitation&timezone=auto&forecast_days=1"
    try:
        r = requests.get(url, timeout=10)
        data = r.json()
        precip = data.get('hourly', {}).get('precipitation', [])
        if precip:
            max_intensity = max(precip[:24]) if len(precip) >= 24 else max(precip)
            total = sum(precip[:24]) if len(precip) >= 24 else sum(precip)
            return {'max_intensity': max_intensity, 'total': total, 'status': 'OK'}
        return {'max_intensity': 0, 'total': 0, 'status': 'OK'}
    except:
        return {'max_intensity': 0, 'total': 0, 'status': 'ERROR'}

# ================================================================
# 🧮 TÍNH Q THEO RATIONAL METHOD
# ================================================================
def calc_Q(max_intensity, slope, area):
    C = 0.2 + 0.5 * slope
    if C > 0.9: C = 0.9
    if C < 0.1: C = 0.1
